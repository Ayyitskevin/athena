# Athena runtime environment — copy to /etc/athena/athena.env (or a local .env).
# Never commit real secrets.

# SQLite database (absolute path for long-running services)
ATHENA_DB=/var/lib/athena/athena.db

# Attachment blobs (outside any web-served directory)
ATHENA_ATTACH_DIR=/var/lib/athena/attachments

# Browser sessions: set 1 when served over HTTPS behind a reverse proxy
ATHENA_COOKIE_SECURE=0
ATHENA_SESSION_TTL_DAYS=14

# Request / agent safety
ATHENA_MAX_REQUEST_BODY_BYTES=1048576
ATHENA_TOKEN_RATE_LIMIT_PER_MINUTE=120
ATHENA_ATTACH_MAX_BYTES=10485760

# Trusted local bootstrap only — leave false in real deployments
ATHENA_TRUST_ACTOR_HEADER=0

# Optional OIDC (see docs/OPERATIONS.md)
# ATHENA_OIDC_ISSUER=
# ATHENA_OIDC_CLIENT_ID=
# ATHENA_OIDC_CLIENT_SECRET=
