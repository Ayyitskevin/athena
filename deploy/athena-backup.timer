# Daily Athena SQLite backup (system unit).
# Pair with athena-backup.service.
#
#   sudo cp deploy/athena-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now athena-backup.timer
#   systemctl list-timers athena-backup.timer

[Unit]
Description=Daily Athena database backup
Requires=athena-backup.service

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
