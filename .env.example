# Athena runtime configuration.
# Copy to .env for local process managers, but do not commit real .env files.

# SQLite database path. Keep the directory writable by the Athena service user.
ATHENA_DB=/var/lib/athena/athena.db

# Trust X-Athena-Actor only on a trusted local/tailnet box. Keep off for deploys.
ATHENA_TRUST_ACTOR_HEADER=0

# Set to 1 when Athena is served over HTTPS.
ATHENA_COOKIE_SECURE=1

# Browser session lifetime.
ATHENA_SESSION_TTL_DAYS=14

# Max request body size in bytes. Set to 0 only if a trusted proxy enforces this.
ATHENA_MAX_REQUEST_BODY_BYTES=1048576
